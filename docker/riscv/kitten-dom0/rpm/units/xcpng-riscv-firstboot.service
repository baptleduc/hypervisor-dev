[Unit]
Description=RISC-V dom0: pool name, PIFs and VM template once xapi is up
Requires=xapi.service
After=xapi-init-complete.target xapi.service
Wants=xapi-init-complete.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/xcpng-riscv/firstboot

[Install]
WantedBy=multi-user.target
