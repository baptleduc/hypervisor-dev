#!/bin/bash
# Once xapi is up (xcpng-riscv-firstboot.service): name the pool, and
# introduce the dom0 NICs as PIFs so XO lists them and rrdp-netdev graphs
# them. Not plugged: plugging bridges eth0, which carries the QEMU hostfwd
# that XO comes in through.
set -u
# xapi-init-complete is not enough: xe can still be refused for a while
i=0
until pool=$(xe pool-list --minimal 2>/dev/null) && [ -n "$pool" ]; do
    i=$((i + 1))
    [ $i -le 150 ] || { echo "xapi never answered" >&2; exit 1; }
    sleep 2
done
name=$(xe pool-param-get uuid="$pool" param-name=name-label) || exit 1
[ -n "$name" ] || xe pool-param-set uuid="$pool" name-label="XCP-ng on RISC-V" || exit 1
xe pif-scan host-uuid="$(xe host-list --minimal)"
